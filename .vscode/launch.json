{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug HelloOpenGL",
            "type": "cppdbg",
            "request": "launch",

            "program": "${command:cmake.launchTargetPath}",

            "cwd": "${workspaceFolder}",

            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",

            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin"
                }
            ],

            "externalConsole": false
        }
    ]
}